# 一般不用手改：桌面端「设置」窗口里改，保存时会写进 .env（没有的话照这份建一个）。
# 也可以复制成 .env 自己填。.env 不会进 Git。
# 任何兼容 OpenAI 接口的大模型都可以，默认 DeepSeek。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 留空时用内置的假模型（只会几句固定回复），方便不联网调试
LLM_API_KEY=

# 联网搜索：bocha（博查，国内，中文结果好）、tavily（海外，每月 1000 次免费）或 none（不用）
# 不填密钥时她只能读你给的链接，不能自己搜（假模型配假搜索除外）
SEARCH_PROVIDER=bocha
SEARCH_API_KEY=

# 只监听本机，语音和屏幕数据以后也不出这台电脑
AILA_HOST=127.0.0.1
AILA_PORT=8765
# 每次带给大模型的最近消息条数
AILA_MAX_HISTORY=20

# ---------- 语音（模型用 scripts/download_models.py 下载，全部在本机跑） ----------
# off 关闭语音，不加载模型
AILA_VOICE=on
# 合成引擎：melo（默认，中英混读）/ kokoro（音色多，慢一倍）/ matcha（最快，只会中文）
AILA_TTS_ENGINE=melo
# 音色编号（kokoro 有上百种，melo 和 matcha 只有 0）
AILA_TTS_SPEAKER=0
AILA_TTS_SPEED=1.0
# 唤醒灵敏度：越低越容易被叫醒，也越容易误唤醒
AILA_WAKE_THRESHOLD=0.25
# 停顿多少秒算说完：太短会把一句话切断，太长她反应慢
AILA_END_SILENCE=0.4
# 识别语种：zh（默认，短句更准，中英混说也能认）或 auto
AILA_ASR_LANGUAGE=zh

# ---------- 其他（一般用默认就好） ----------
# 资料库等本机数据放在哪（默认 aila-ai/data）
# AILA_DATA_DIR=
# 外部 MCP 服务的配置（默认 aila-ai/mcp.json，格式见 mcp.example.json）
# AILA_MCP_CONFIG=

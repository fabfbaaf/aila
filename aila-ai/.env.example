# 复制成 .env 再填。.env 不会进 Git。
# 任何兼容 OpenAI 接口的大模型都可以，默认 DeepSeek。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 留空时用内置的假模型（只会几句固定回复），方便不联网调试
LLM_API_KEY=

# 联网搜索：bocha（博查，国内，中文结果好）或 tavily（海外，每月 1000 次免费）
# 不填密钥时她只能读你给的链接，不能自己搜（假模型配假搜索除外）
SEARCH_PROVIDER=bocha
SEARCH_API_KEY=

# 只监听本机，语音和屏幕数据以后也不出这台电脑
AILA_HOST=127.0.0.1
AILA_PORT=8765
# 每次带给大模型的最近消息条数
AILA_MAX_HISTORY=20

# 复制成 .env 再填（.env 不进 Git）。

# 数据库密码：随便一串长的。生成：openssl rand -hex 24
AILA_DB_PASSWORD=

# 访问令牌的签名密钥：32 字节以上，Base64。生成：openssl rand -base64 48
# Windows PowerShell：$b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# 换了它，所有设备都要重新登录
AILA_JWT_SECRET=

# 同步服务在哪个地址上听：127.0.0.1 只给本机（配 Caddy 时用这个）；0.0.0.0 让局域网、ZeroTier 里的电脑也能连
AILA_BIND=127.0.0.1

# 用 --profile https 时填：解析到这台机器的域名（80、443 端口要能从外网访问）
AILA_DOMAIN=

# 放在 Caddy 后面时改成 native（按 X-Forwarded-For 认客户端 IP，限流要用）；直接对外时保持 none
AILA_FORWARD_HEADERS=none

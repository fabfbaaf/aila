{
  "name": "aila-desktop",
  "version": "0.3.2",
  "description": "艾拉：程序员的 AI 桌面伙伴",
  "main": "./out/main/index.js",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dev:web": "vite --config vite.web.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "setup:gestures": "node scripts/setup-gestures.mjs",
    "setup:live2d": "node scripts/setup-live2d.mjs",
    "pack:local": "node scripts/pack-local.mjs",
    "icon": "electron scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --config electron-builder.yml --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.0",
    "@pixi/unsafe-eval": "^6.5.10",
    "@pixiv/three-vrm": "^3.1.0",
    "d3-force-3d": "^3.0.6",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "three": "^0.169.0",
    "vue": "^3.5.12",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "^33.2.0",
    "electron-builder": "26.18.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.10"
  }
}
